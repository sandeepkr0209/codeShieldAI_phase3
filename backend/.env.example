# --- General ---
APP_ENV=development
DEBUG=true

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://codeshield:codeshield@localhost:5432/codeshieldai

# --- Auth ---
# Generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Set to true only once served over HTTPS — cookies won't be sent over plain http otherwise
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173

# --- Google OAuth (optional) ---
# 1. https://console.cloud.google.com/apis/credentials
# 2. Create OAuth client ID > Web application
# 3. Authorized redirect URI: http://localhost:8000/api/auth/google/callback
# Leave blank to disable Google sign-in (/api/auth/google will return 503)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- LLM / Groq ---
# Get a key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Logging ---
LOG_LEVEL=INFO
